# 复制为 .env 后填写（.env 已被 .gitignore 忽略，切勿提交真实 Token）

# 麦当劳 MCP Token：在 https://open.mcd.cn/mcp 用手机号登录后申请
MCD_MCP_TOKEN=your_mcp_token_here

# 可选：覆盖 MCP 接入地址（默认 https://mcp.mcd.cn）
# 用途：指着本地假服务端跑集成测试，例如 MCD_MCP_BASE=http://127.0.0.1:8765
# ⚠️ 环境变量名必须与代码一致：MCD_MCP_BASE
# MCD_MCP_BASE=https://mcp.mcd.cn

# 可选：默认预算上限（元），不填则不限制
# MCD_DEFAULT_BUDGET=40
